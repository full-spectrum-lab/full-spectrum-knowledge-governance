{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-spectrum-lab.example/schemas/knowledge/v1.0/fixed-knowledge-candidate.schema.json",
  "title": "Fixed Knowledge Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot_id", "knowledge_id", "version", "artifact_id"],
  "properties": {
    "slot_id": { "type": "string", "minLength": 1 },
    "knowledge_id": { "type": "string", "pattern": "^KG-[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "artifact_id": { "type": "string", "minLength": 1 }
  }
}
