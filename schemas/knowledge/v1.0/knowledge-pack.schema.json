{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-spectrum-lab.example/schemas/knowledge/v1.0/knowledge-pack.schema.json",
  "title": "Knowledge Pack",
  "type": "object",
  "required": [
    "contract_version",
    "knowledge_id",
    "version",
    "state",
    "title",
    "description",
    "artifacts",
    "scope",
    "created_at_utc"
  ],
  "properties": {
    "contract_version": { "const": "knowledge-contract/1.0.0" },
    "knowledge_id": {
      "type": "string",
      "pattern": "^KG-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "state": {
      "enum": ["DRAFT", "REVIEW_REQUIRED", "RELEASED", "SUPERSEDED", "REVOKED"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "media_type", "size", "digest", "relative_path"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "digest": {
            "type": "object",
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": { "const": "SHA-256" },
              "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          },
          "relative_path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "created_at_utc": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
