{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-spectrum-lab.example/schemas/knowledge/v1.0/domain-resolution-plan.schema.json",
  "title": "Domain Resolution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_code", "profile_version", "subject_id", "candidates", "expectations", "plan_digest"],
  "properties": {
    "profile_code": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string" },
    "subject_id": { "type": "string", "minLength": 1 },
    "candidates": { "type": "array" },
    "expectations": { "type": "array", "minItems": 1 },
    "plan_digest": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "value"],
      "properties": { "algorithm": { "const": "SHA-256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    }
  }
}
