{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-spectrum-lab.example/schemas/knowledge/v1.0/domain-resolution-plan.schema.json",
  "title": "Domain Resolution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_code", "profile_version", "subject_id", "candidates", "expectations", "plan_digest"],
  "properties": {
    "profile_code": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "subject_id": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "knowledge_id", "version", "artifact_id"],
        "properties": {
          "slot_id": { "type": "string", "minLength": 1 },
          "knowledge_id": { "type": "string", "pattern": "^KG-[A-Z0-9][A-Z0-9._-]{2,63}$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
          "artifact_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "required_granularity"],
        "properties": {
          "slot_id": { "type": "string", "minLength": 1 },
          "required_granularity": { "enum": ["INDUSTRY", "CATEGORY", "SERIES", "MODEL", "FEATURE"] }
        }
      }
    },
    "plan_digest": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "value"],
      "properties": { "algorithm": { "const": "SHA-256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    }
  }
}
