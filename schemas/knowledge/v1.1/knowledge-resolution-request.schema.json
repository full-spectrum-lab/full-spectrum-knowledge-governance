{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-spectrum-lab.example/schemas/knowledge/v1.1/knowledge-resolution-request.schema.json",
  "title": "Knowledge Resolution Request v1.1",
  "type": "object",
  "required": ["contract_version", "request_id", "mode", "subject_digest", "required_slots", "context"],
  "properties": {
    "contract_version": { "const": "knowledge-contract/1.1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "mode": { "const": "FIXED_ONLY" },
    "subject_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "required_slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "context": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
