{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-spectrum.dev/schemas/knowledge/v2.0/knowledge-source-registration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id","source_version","publisher","kind","terms_reference","access_policy_reference","adapter_id","adapter_version","allowed_origins","state","created_at_utc","registration_digest"],
  "properties": {
    "source_id": {"type":"string","minLength":1}, "source_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}, "publisher": {"type":"string","minLength":1},
    "kind": {"enum":["RSS","API","HTML","MANUAL","SEARCH"]}, "terms_reference":{"type":"string","minLength":1}, "access_policy_reference":{"type":"string","minLength":1},
    "adapter_id":{"type":"string","minLength":1}, "adapter_version":{"type":"string","minLength":1}, "allowed_origins":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "state":{"enum":["DRAFT","REVIEW_REQUIRED","ACTIVE","REVOKED"]}, "created_at_utc":{"type":"string","format":"date-time"},
    "registration_digest":{"$ref":"#/$defs/digest"}
  },
  "$defs":{"digest":{"type":"object","additionalProperties":false,"required":["algorithm","value"],"properties":{"algorithm":{"const":"SHA-256"},"value":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}
}
