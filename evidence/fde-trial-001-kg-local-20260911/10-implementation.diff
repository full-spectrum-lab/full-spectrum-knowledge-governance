+using System.Globalization;
+using System.Text.Json;
+using FullSpectrum.Knowledge.Contracts;
+
+namespace FullSpectrum.Knowledge.Storage;
+
+public sealed record FdePolicySnapshot(
+    string CaseId,
+    string FixtureVersion,
+    string SnapshotRef,
+    string? ParentSnapshotRef,
+    string PolicyId,
+    string PolicyVersion,
+    string Status,
+    string SourceRef,
+    string SourceDigestScope,
+    string SourceContentSha256,
+    string PolicyDocumentSha256);
+
+public sealed record FdeEngineAuditRecord(
+    string EventId,
+    string CaseId,
+    string FixtureVersion,
+    string KnowledgeSnapshotRef,
+    string EngineInputJson,
+    string EngineInputSha256,
+    string EngineResultJson,
+    string EngineResultSha256,
+    string OriginalEngineResultSha256,
+    DateTimeOffset OccurredAtUtc);
+
+public sealed record FdeHumanDecisionEvent(
+    string EventId,
+    string CaseId,
+    string FixtureVersion,
+    string EngineAuditEventId,
+    string KnowledgeSnapshotRef,
+    string PolicyId,
+    string PolicyVersion,
+    string Decision,
+    string ResultingSnapshotState,
+    string ActorId,
+    string AuthorityRef,
+    IReadOnlyList<string> AuthorityScope,
+    DateTimeOffset AuthorityIssuedAtUtc,
+    DateTimeOffset AuthorityExpiresAtUtc,
+    DateTimeOffset OccurredAtUtc);
+
+public sealed record FdeActionOutcomeRecord(
+    string EventId,
+    string CaseId,
+    string FixtureVersion,
+    string HumanDecisionEventId,
+    string Outcome,
+    string ActionType,
+    string TargetRef,
+    string ActionIdempotencyKey,
+    string InputSha256,
+    string ResultSha256,
+    string? ReceiptJson,
+    DateTimeOffset OccurredAtUtc);
+
+public sealed record FdeTrial001Replay(
+    string CaseId,
+    string FixtureVersion,
+    IReadOnlyList<FdePolicySnapshot> Snapshots,
+    FdeEngineAuditRecord EngineAudit,
+    FdeHumanDecisionEvent HumanDecision,
+    FdeActionOutcomeRecord ActionOutcome,
+    string CandidateState,
+    string ReplaySha256);
+
+public sealed class FdeTrial001RejectedException(
+    string errorCode,
+    string message,
+    string retryPreconditions = "NONE",
+    Exception? innerException = null) : InvalidOperationException(message, innerException)
+{
+    public string ErrorCode { get; } = errorCode;
+    public bool ActionAllowed => false;
+    public string RetryPreconditions { get; } = retryPreconditions;
+}
+
+/// <summary>
+/// Local-only, append-only persistence and replay boundary for FDE-TRIAL-001.
+/// It stores governed facts and receipts but never decides refunds or invokes an action sink.
+/// </summary>
+public sealed class FdeTrial001Registry : IDisposable
+{
+    public const string CaseId = "FDE-TRIAL-001";
+    public const string FixtureVersion = "0.1.0-rc";
+
+    private const string SnapshotEvent = "POLICY_SNAPSHOT_PERSISTED";
+    private const string EngineAuditEvent = "ENGINE_AUDIT_PERSISTED";
+    private const string HumanDecisionEvent = "HUMAN_DECISION_APPENDED";
+    private const string ActionOutcomeEvent = "ACTION_OUTCOME_PERSISTED";
+
+    private readonly SqliteDatabase database;
+
+    public FdeTrial001Registry(string databasePath)
+    {
+        database = new SqliteDatabase(databasePath);
+        database.ExecuteScript("""
+            CREATE TABLE IF NOT EXISTS kg_fde_trial_001_events (
+                sequence INTEGER PRIMARY KEY AUTOINCREMENT,
+                case_id TEXT NOT NULL,
+                fixture_version TEXT NOT NULL,
+                event_id TEXT NOT NULL UNIQUE,
+                event_type TEXT NOT NULL,
+                idempotency_key TEXT NOT NULL UNIQUE,
+                payload TEXT NOT NULL,
+                previous_digest TEXT NOT NULL,
+                event_digest TEXT NOT NULL
+            );
+            CREATE INDEX IF NOT EXISTS ix_kg_fde_trial_001_case
+                ON kg_fde_trial_001_events(case_id, fixture_version, sequence);
+            """);
+    }
+
+    public FdePolicySnapshot AppendSnapshot(FdePolicySnapshot snapshot)
+    {
+        ValidateIdentity(snapshot.CaseId, snapshot.FixtureVersion);
+        Require(snapshot.SnapshotRef, nameof(snapshot.SnapshotRef));
+        Require(snapshot.PolicyId, nameof(snapshot.PolicyId));
+        Require(snapshot.PolicyVersion, nameof(snapshot.PolicyVersion));
+        Require(snapshot.SourceRef, nameof(snapshot.SourceRef));
+        Require(snapshot.SourceDigestScope, nameof(snapshot.SourceDigestScope));
+        RequireSha256(snapshot.SourceContentSha256, nameof(snapshot.SourceContentSha256));
+        RequireSha256(snapshot.PolicyDocumentSha256, nameof(snapshot.PolicyDocumentSha256));
+
+        if (snapshot.Status is not ("ACTIVE" or "PROPOSED"))
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "Snapshot status must be ACTIVE or PROPOSED.");
+
+        if (snapshot.Status == "ACTIVE" && snapshot.ParentSnapshotRef is not null)
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "The frozen parent snapshot must not declare a parent.");
+
+        if (snapshot.Status == "PROPOSED")
+        {
+            Require(snapshot.ParentSnapshotRef, nameof(snapshot.ParentSnapshotRef));
+            var parent = FindSnapshot(snapshot.CaseId, snapshot.FixtureVersion, snapshot.ParentSnapshotRef!);
+            if (parent is null)
+                throw Reject("REPLAY_DEPENDENCY_MISSING", "The candidate snapshot parent is not persisted.");
+            if (parent.Status != "ACTIVE" || parent.PolicyId != snapshot.PolicyId)
+                throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "The candidate snapshot parent binding is invalid.");
+        }
+
+        return Append(SnapshotEvent, $"snapshot:{snapshot.SnapshotRef}", $"snapshot:{snapshot.SnapshotRef}", snapshot);
+    }
+
+    public FdeEngineAuditRecord AppendEngineAudit(FdeEngineAuditRecord audit)
+    {
+        ValidateIdentity(audit.CaseId, audit.FixtureVersion);
+        Require(audit.EventId, nameof(audit.EventId));
+        Require(audit.KnowledgeSnapshotRef, nameof(audit.KnowledgeSnapshotRef));
+        RequireCanonicalDigest(audit.EngineInputJson, audit.EngineInputSha256, nameof(audit.EngineInputSha256));
+        RequireCanonicalDigest(audit.EngineResultJson, audit.EngineResultSha256, nameof(audit.EngineResultSha256));
+        if (!Matches(audit.EngineResultSha256, audit.OriginalEngineResultSha256))
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Engine result does not match its immutable original digest.");
+
+        var candidate = FindSnapshot(audit.CaseId, audit.FixtureVersion, audit.KnowledgeSnapshotRef);
+        if (candidate is null || candidate.Status != "PROPOSED")
+            throw Reject("REPLAY_DEPENDENCY_MISSING", "The Engine audit is not bound to a persisted candidate snapshot.");
+
+        return Append(EngineAuditEvent, audit.EventId, $"engine-audit:{audit.EventId}", audit);
+    }
+
+    public FdeHumanDecisionEvent AppendHumanDecision(FdeHumanDecisionEvent decision)
+    {
+        ValidateIdentity(decision.CaseId, decision.FixtureVersion);
+        Require(decision.EventId, nameof(decision.EventId));
+        Require(decision.EngineAuditEventId, nameof(decision.EngineAuditEventId));
+        Require(decision.KnowledgeSnapshotRef, nameof(decision.KnowledgeSnapshotRef));
+        Require(decision.PolicyId, nameof(decision.PolicyId));
+        Require(decision.PolicyVersion, nameof(decision.PolicyVersion));
+        Require(decision.ActorId, nameof(decision.ActorId));
+        Require(decision.AuthorityRef, nameof(decision.AuthorityRef));
+
+        if (decision.Decision is not ("APPROVE" or "REJECT"))
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "Human decision must be APPROVE or REJECT.");
+        var expectedState = decision.Decision == "APPROVE" ? "ACTIVE" : "REJECTED";
+        if (decision.ResultingSnapshotState != expectedState)
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "Human decision does not match its appended snapshot lifecycle state.");
+        if (decision.AuthorityIssuedAtUtc >= decision.AuthorityExpiresAtUtc ||
+            decision.OccurredAtUtc < decision.AuthorityIssuedAtUtc ||
+            decision.OccurredAtUtc > decision.AuthorityExpiresAtUtc)
+            throw Reject("CREDENTIAL_EXPIRED", "Human authority is not valid at the decision time.");
+
+        var requiredScope = decision.Decision == "APPROVE"
+            ? "APPROVE_POLICY_ACTIVATION"
+            : "REJECT_POLICY_ACTIVATION";
+        if (!decision.AuthorityScope.Contains(requiredScope, StringComparer.Ordinal))
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "Human authority does not cover the requested decision.");
+
+        var audit = Find<FdeEngineAuditRecord>(decision.CaseId, decision.FixtureVersion, EngineAuditEvent, decision.EngineAuditEventId);
+        if (audit is null || audit.KnowledgeSnapshotRef != decision.KnowledgeSnapshotRef)
+            throw Reject("REPLAY_DEPENDENCY_MISSING", "Human decision is not bound to the persisted Engine audit and candidate snapshot.");
+        if (decision.OccurredAtUtc < audit.OccurredAtUtc)
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "Human decision cannot predate the persisted Engine audit.");
+        var candidate = FindSnapshot(decision.CaseId, decision.FixtureVersion, decision.KnowledgeSnapshotRef);
+        if (candidate is null || candidate.PolicyId != decision.PolicyId || candidate.PolicyVersion != decision.PolicyVersion)
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "Human authority policy binding does not match the candidate snapshot.");
+
+        var prior = ReadEvents(decision.CaseId, decision.FixtureVersion)
+            .Where(row => row.EventType == HumanDecisionEvent)
+            .Select(row => Deserialize<FdeHumanDecisionEvent>(row.Payload))
+            .SingleOrDefault(item => item.KnowledgeSnapshotRef == decision.KnowledgeSnapshotRef);
+        if (prior is not null && Engine2CanonicalJson.Serialize(prior) != Engine2CanonicalJson.Serialize(decision))
+            throw Reject("IDEMPOTENCY_CONFLICT", "The candidate snapshot already has a different human decision.");
+
+        return Append(HumanDecisionEvent, decision.EventId, $"human-decision:{decision.KnowledgeSnapshotRef}", decision);
+    }
+
+    public FdeActionOutcomeRecord AppendActionOutcome(FdeActionOutcomeRecord outcome)
+    {
+        ValidateIdentity(outcome.CaseId, outcome.FixtureVersion);
+        Require(outcome.EventId, nameof(outcome.EventId));
+        Require(outcome.HumanDecisionEventId, nameof(outcome.HumanDecisionEventId));
+        Require(outcome.ActionType, nameof(outcome.ActionType));
+        Require(outcome.TargetRef, nameof(outcome.TargetRef));
+        Require(outcome.ActionIdempotencyKey, nameof(outcome.ActionIdempotencyKey));
+        RequireSha256(outcome.InputSha256, nameof(outcome.InputSha256));
+        RequireSha256(outcome.ResultSha256, nameof(outcome.ResultSha256));
+
+        var decision = Find<FdeHumanDecisionEvent>(outcome.CaseId, outcome.FixtureVersion, HumanDecisionEvent, outcome.HumanDecisionEventId);
+        if (decision is null)
+            throw Reject("REPLAY_DEPENDENCY_MISSING", "Action outcome is not bound to a persisted human decision.");
+        if (outcome.OccurredAtUtc < decision.OccurredAtUtc)
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "Action outcome cannot predate its human decision.");
+
+        if (outcome.Outcome == "ACTION_RECEIPT")
+        {
+            if (decision.Decision != "APPROVE" ||
+                !decision.AuthorityScope.Contains("AUTHORIZE_LOCAL_FAKE_ACTION", StringComparer.Ordinal))
+                throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "An action receipt requires persisted local-fake-action approval.");
+            Require(outcome.ReceiptJson, nameof(outcome.ReceiptJson));
+            RequireCanonicalDigest(outcome.ReceiptJson!, outcome.ResultSha256, nameof(outcome.ResultSha256));
+        }
+        else if (outcome.Outcome == "NO_ACTION")
+        {
+            if (outcome.ReceiptJson is not null)
+                throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "NO_ACTION must not contain an action receipt.");
+        }
+        else
+        {
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "Action outcome must be ACTION_RECEIPT or NO_ACTION.");
+        }
+
+        return Append(
+            ActionOutcomeEvent,
+            outcome.EventId,
+            $"action-outcome:{outcome.ActionIdempotencyKey}",
+            outcome,
+            "RECONCILE_ACTION_IDEMPOTENCY_KEY_BEFORE_ANY_RETRY_DECISION");
+    }
+
+    public FdeTrial001Replay Replay(string caseId = CaseId, string fixtureVersion = FixtureVersion)
+    {
+        ValidateIdentity(caseId, fixtureVersion);
+        var rows = ReadEvents(caseId, fixtureVersion);
+        try
+        {
+            var snapshots = rows.Where(row => row.EventType == SnapshotEvent)
+                .Select(row => Deserialize<FdePolicySnapshot>(row.Payload)).ToArray();
+            var parent = snapshots.SingleOrDefault(item => item.Status == "ACTIVE" && item.ParentSnapshotRef is null)
+                ?? throw Reject("REPLAY_DEPENDENCY_MISSING", "The frozen parent snapshot is missing.");
+            var candidate = snapshots.SingleOrDefault(item => item.Status == "PROPOSED")
+                ?? throw Reject("REPLAY_DEPENDENCY_MISSING", "The candidate snapshot is missing.");
+            if (candidate.ParentSnapshotRef != parent.SnapshotRef || candidate.PolicyId != parent.PolicyId)
+                throw Reject("EVIDENCE_DIGEST_MISMATCH", "Snapshot parent relationship is invalid during replay.");
+
+            var audit = Single<FdeEngineAuditRecord>(rows, EngineAuditEvent);
+            RequireCanonicalDigest(audit.EngineInputJson, audit.EngineInputSha256, nameof(audit.EngineInputSha256));
+            RequireCanonicalDigest(audit.EngineResultJson, audit.EngineResultSha256, nameof(audit.EngineResultSha256));
+            if (!Matches(audit.EngineResultSha256, audit.OriginalEngineResultSha256) ||
+                audit.KnowledgeSnapshotRef != candidate.SnapshotRef)
+                throw Reject("EVIDENCE_DIGEST_MISMATCH", "Engine audit is not immutable or is not bound to the candidate snapshot.");
+
+            var decision = Single<FdeHumanDecisionEvent>(rows, HumanDecisionEvent);
+            ValidateReplayedDecision(decision, audit);
+            if (decision.PolicyId != candidate.PolicyId || decision.PolicyVersion != candidate.PolicyVersion)
+                throw Reject("EVIDENCE_DIGEST_MISMATCH", "Human decision policy binding is invalid during replay.");
+            var action = Single<FdeActionOutcomeRecord>(rows, ActionOutcomeEvent);
+            ValidateReplayedAction(action, decision);
+
+            var state = decision.Decision == "APPROVE" ? "ACTIVE" : "REJECTED";
+            var replayDigest = Engine2CanonicalJson.ComputeSha256(new
+            {
+                case_id = caseId,
+                fixture_version = fixtureVersion,
+                event_digests = rows.Select(row => row.EventDigest).ToArray(),
+                candidate_state = state
+            });
+            return new FdeTrial001Replay(caseId, fixtureVersion, snapshots, audit, decision, action, state, replayDigest);
+        }
+        catch (FdeTrial001RejectedException)
+        {
+            throw;
+        }
+        catch (Exception exception)
+        {
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "FDE-TRIAL-001 replay validation failed.", innerException: exception);
+        }
+    }
+
+    public static string ComputeCanonicalSha256(string json) => Engine2CanonicalJson.ComputeSha256(json);
+
+    private T Append<T>(string eventType, string eventId, string idempotencyKey, T value, string persistenceRetry = "NO_ACTION_RETRY_ONLY_AFTER_PERSISTENCE_RECOVERY")
+    {
+        var payload = Engine2CanonicalJson.Serialize(value);
+        try
+        {
+            var existing = database.Query(
+                "SELECT event_type, payload FROM kg_fde_trial_001_events WHERE event_id = ? OR idempotency_key = ?",
+                row => (EventType: row.Text(0), Payload: row.Text(1)), eventId, idempotencyKey);
+            if (existing.Count > 0)
+            {
+                if (existing.All(row => row.EventType == eventType && row.Payload == payload)) return value;
+                throw Reject("IDEMPOTENCY_CONFLICT", "FDE event identity was reused with different content.");
+            }
+
+            return database.Transaction(() =>
+            {
+                var previous = database.Query(
+                    "SELECT event_digest FROM kg_fde_trial_001_events WHERE case_id = ? AND fixture_version = ? ORDER BY sequence DESC LIMIT 1",
+                    row => row.Text(0), CaseId, FixtureVersion).SingleOrDefault() ?? string.Empty;
+                var digest = EventDigest(CaseId, FixtureVersion, eventId, eventType, idempotencyKey, payload, previous);
+                database.Execute(
+                    "INSERT INTO kg_fde_trial_001_events(case_id, fixture_version, event_id, event_type, idempotency_key, payload, previous_digest, event_digest) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+                    CaseId, FixtureVersion, eventId, eventType, idempotencyKey, payload, previous, digest);
+                return value;
+            });
+        }
+        catch (FdeTrial001RejectedException)
+        {
+            throw;
+        }
+        catch (Exception exception)
+        {
+            throw Reject("AUDIT_PERSISTENCE_FAILED", "Required FDE persistence failed.", persistenceRetry, exception);
+        }
+    }
+
+    private IReadOnlyList<StoredEvent> ReadEvents(string caseId, string fixtureVersion)
+    {
+        IReadOnlyList<StoredEvent> rows;
+        try
+        {
+            rows = database.Query(
+                "SELECT sequence, event_id, event_type, idempotency_key, payload, previous_digest, event_digest FROM kg_fde_trial_001_events WHERE case_id = ? AND fixture_version = ? ORDER BY sequence",
+                row => new StoredEvent(row.Int64(0), row.Text(1), row.Text(2), row.Text(3), row.Text(4), row.Text(5), row.Text(6)),
+                caseId, fixtureVersion);
+        }
+        catch (Exception exception)
+        {
+            throw Reject("AUDIT_PERSISTENCE_FAILED", "Required FDE replay storage could not be read.", innerException: exception);
+        }
+
+        var previous = string.Empty;
+        foreach (var row in rows)
+        {
+            var expected = EventDigest(caseId, fixtureVersion, row.EventId, row.EventType, row.IdempotencyKey, row.Payload, previous);
+            if (!Matches(row.PreviousDigest, previous) || !Matches(row.EventDigest, expected))
+                throw Reject("EVIDENCE_DIGEST_MISMATCH", "Persisted FDE event chain integrity check failed.");
+            previous = row.EventDigest;
+        }
+        return rows;
+    }
+
+    private FdePolicySnapshot? FindSnapshot(string caseId, string fixtureVersion, string snapshotRef) =>
+        ReadEvents(caseId, fixtureVersion)
+            .Where(row => row.EventType == SnapshotEvent)
+            .Select(row => Deserialize<FdePolicySnapshot>(row.Payload))
+            .SingleOrDefault(item => item.SnapshotRef == snapshotRef);
+
+    private T? Find<T>(string caseId, string fixtureVersion, string eventType, string eventId) where T : class =>
+        ReadEvents(caseId, fixtureVersion)
+            .Where(row => row.EventType == eventType && row.EventId == eventId)
+            .Select(row => Deserialize<T>(row.Payload))
+            .SingleOrDefault();
+
+    private static T Single<T>(IReadOnlyList<StoredEvent> rows, string eventType) where T : class =>
+        rows.Where(row => row.EventType == eventType)
+            .Select(row => Deserialize<T>(row.Payload))
+            .SingleOrDefault()
+        ?? throw Reject("REPLAY_DEPENDENCY_MISSING", $"Required replay event {eventType} is missing.");
+
+    private static void ValidateReplayedDecision(FdeHumanDecisionEvent decision, FdeEngineAuditRecord audit)
+    {
+        if (decision.EngineAuditEventId != audit.EventId || decision.KnowledgeSnapshotRef != audit.KnowledgeSnapshotRef)
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Human decision replay binding is invalid.");
+        if (decision.OccurredAtUtc < audit.OccurredAtUtc)
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Human decision predates the Engine audit during replay.");
+        if (decision.Decision is not ("APPROVE" or "REJECT"))
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Human decision replay value is invalid.");
+        var expectedState = decision.Decision == "APPROVE" ? "ACTIVE" : "REJECTED";
+        if (decision.ResultingSnapshotState != expectedState)
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Human decision snapshot state is invalid during replay.");
+        var requiredScope = decision.Decision == "APPROVE" ? "APPROVE_POLICY_ACTIVATION" : "REJECT_POLICY_ACTIVATION";
+        if (!decision.AuthorityScope.Contains(requiredScope, StringComparer.Ordinal) ||
+            decision.AuthorityIssuedAtUtc >= decision.AuthorityExpiresAtUtc ||
+            decision.OccurredAtUtc < decision.AuthorityIssuedAtUtc ||
+            decision.OccurredAtUtc > decision.AuthorityExpiresAtUtc)
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Human decision authority is invalid during replay.");
+    }
+
+    private static void ValidateReplayedAction(FdeActionOutcomeRecord action, FdeHumanDecisionEvent decision)
+    {
+        if (action.HumanDecisionEventId != decision.EventId)
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Action outcome is not bound to the human decision.");
+        if (action.OccurredAtUtc < decision.OccurredAtUtc)
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Action outcome predates its human decision.");
+        RequireSha256(action.InputSha256, nameof(action.InputSha256));
+        RequireSha256(action.ResultSha256, nameof(action.ResultSha256));
+        if (action.Outcome == "ACTION_RECEIPT")
+        {
+            if (decision.Decision != "APPROVE" ||
+                !decision.AuthorityScope.Contains("AUTHORIZE_LOCAL_FAKE_ACTION", StringComparer.Ordinal) ||
+                action.ReceiptJson is null)
+                throw Reject("EVIDENCE_DIGEST_MISMATCH", "Action receipt is not backed by approval.");
+            RequireCanonicalDigest(action.ReceiptJson, action.ResultSha256, nameof(action.ResultSha256));
+        }
+        else if (action.Outcome != "NO_ACTION" || action.ReceiptJson is not null)
+        {
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Action outcome is invalid during replay.");
+        }
+    }
+
+    private static string EventDigest(string caseId, string fixtureVersion, string eventId, string eventType, string idempotencyKey, string payload, string previousDigest) =>
+        Engine2CanonicalJson.ComputeSha256(new
+        {
+            case_id = caseId,
+            fixture_version = fixtureVersion,
+            event_id = eventId,
+            event_type = eventType,
+            idempotency_key = idempotencyKey,
+            payload,
+            previous_digest = previousDigest
+        });
+
+    private static T Deserialize<T>(string payload)
+    {
+        try
+        {
+            return JsonSerializer.Deserialize<T>(payload, KnowledgeJson.Options)
+                ?? throw new JsonException("Persisted FDE event payload is null.");
+        }
+        catch (JsonException exception)
+        {
+            throw Reject("EVIDENCE_DIGEST_MISMATCH", "Persisted FDE event payload is invalid.", innerException: exception);
+        }
+    }
+
+    private static void ValidateIdentity(string caseId, string fixtureVersion)
+    {
+        if (caseId != CaseId || fixtureVersion != FixtureVersion)
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", "FDE adapter only accepts the frozen FDE-TRIAL-001 0.1.0-rc identity.");
+    }
+
+    private static void RequireCanonicalDigest(string json, string digest, string field)
+    {
+        RequireSha256(digest, field);
+        try
+        {
+            if (!Matches(Engine2CanonicalJson.ComputeSha256(json), digest))
+                throw Reject("EVIDENCE_DIGEST_MISMATCH", $"{field} does not match its canonical JSON payload.");
+        }
+        catch (JsonException exception)
+        {
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", $"{field} payload is not valid canonical JSON input.", innerException: exception);
+        }
+    }
+
+    private static void RequireSha256(string value, string field)
+    {
+        if (value.Length != 64 || value.Any(character => !Uri.IsHexDigit(character)))
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", $"{field} must be a SHA-256 hexadecimal digest.");
+    }
+
+    private static bool Matches(string left, string right) =>
+        string.Equals(left, right, StringComparison.OrdinalIgnoreCase);
+
+    private static void Require(string? value, string field)
+    {
+        if (string.IsNullOrWhiteSpace(value))
+            throw Reject("PROTOCOL_OBJECT_UNTRUSTED", $"Required FDE field '{field}' is empty.");
+    }
+
+    private static FdeTrial001RejectedException Reject(
+        string code,
+        string message,
+        string retryPreconditions = "NONE",
+        Exception? innerException = null) => new(code, message, retryPreconditions, innerException);
+
+    public void Dispose() => database.Dispose();
+
+    private sealed record StoredEvent(
+        long Sequence,
+        string EventId,
+        string EventType,
+        string IdempotencyKey,
+        string Payload,
+        string PreviousDigest,
+        string EventDigest);
+}
