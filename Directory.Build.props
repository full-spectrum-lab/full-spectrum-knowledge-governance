<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <LangVersion>preview</LangVersion>
    <Version>0.1.1-alpha</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == ''">UNKNOWN</RepositoryCommit>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.1.1-alpha+$(RepositoryCommit)</InformationalVersion>
    <NoWarn>$(NoWarn);NETSDK1212</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" />
  </ItemGroup>
</Project>
